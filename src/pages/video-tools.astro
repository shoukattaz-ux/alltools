---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ToolBrowser from '../components/ToolBrowser.astro';
import { CATEGORIES, toolsByCategory } from '../data/tools';
const cat = CATEGORIES.video;
const tools = toolsByCategory('video');
---
<Base title={cat.title} description={cat.description} breadcrumbs={[{ name: cat.name, href: cat.path }]}>
  <Fragment slot="hero">
    <span class="tool-icon cat-video" style="margin-bottom:14px"><Icon name="video" /></span>
    <h1>{cat.title}</h1>
    <p class="lead">{cat.blurb}</p>
  </Fragment>
  <ToolBrowser id="video" category="video" showFilters={false} showSearch={false} />
  <section class="section content-block">
    <h2>About these video tools</h2>
    <ul class="ticks">
      {tools.map((t) => <li><a href={`/tools/${t.slug}/`}><strong>{t.name}</strong></a>: {t.short}</li>)}
    </ul>
    <p>Looking for something else? Browse <a href="/tools/">all tools</a> or read our <a href="/blog/">guides</a>.</p>
  </section>
</Base>
