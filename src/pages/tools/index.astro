---
import Base from '../../layouts/Base.astro';
import ToolBrowser from '../../components/ToolBrowser.astro';
import { TOOLS, toolUrl } from '../../data/tools';
import { SITE } from '../../data/site';
const listLd = [{ '@context': 'https://schema.org', '@type': 'ItemList', name: `${SITE.name} tools`, itemListElement: TOOLS.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.name, url: `${SITE.url}${toolUrl(t)}` })) }];
---
<Base jsonLd={listLd} title="All Free Online Tools: PDF, Image & Calculators" description={`Browse all ${TOOLS.length} free tools: merge, split, sign and compress PDFs, compress, resize, crop and convert images, and BMI, age, percentage and discount calculators.`} breadcrumbs={[{ name: 'All tools', href: '/tools/' }]}>
  <Fragment slot="hero">
    <h1>All tools</h1>
    <p class="lead">{TOOLS.length} free tools for PDFs, images and everyday calculations. Search, or filter by category.</p>
  </Fragment>
  <ToolBrowser id="all" autoquery />
</Base>
