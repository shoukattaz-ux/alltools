---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { SITE } from '../data/site';
import { TOOLS, CATEGORIES, toolUrl, type Category } from '../data/tools';
const path = Astro.url.pathname;
const cats = Object.keys(CATEGORIES) as Category[];
const current = (href: string) => (path === href || (href !== '/' && path.startsWith(href)) ? 'page' : undefined);
const catIcon = (c: Category) => (c === 'calculator' ? 'calculator' : c);
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${SITE.name} home`}><Logo /><span>{SITE.name}</span></a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <Icon name="menu" size={22} /><span class="sr-only">Menu</span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Main" data-nav>
      <ul>
        <li class="nav-tools-item">
          <button class="nav-btn" type="button" aria-expanded="false" aria-controls="mega" data-mega-btn>Tools <Icon name="down" size={16} /></button>
        </li>
        <li><a class="nav-link" href="/pdf-tools/" aria-current={current('/pdf-tools/')}>PDF</a></li>
        <li><a class="nav-link" href="/image-tools/" aria-current={current('/image-tools/')}>Image</a></li>
        <li><a class="nav-link" href="/calculators/" aria-current={current('/calculators/')}>Calculators</a></li>
        <li><a class="nav-link" href="/blog/" aria-current={current('/blog/')}>Guides</a></li>
      </ul>
      <a class="btn btn-primary btn-small nav-cta" href="/tools/">All tools <Icon name="arrow" size={16} /></a>
      <div class="mega" id="mega" hidden data-mega>
        {cats.map((c) => (
          <div class="mega-col">
            <h2><span class={`mini-icon cat-${c}`}><Icon name={catIcon(c)} /></span><a href={CATEGORIES[c].path}>{CATEGORIES[c].name}</a></h2>
            <ul>
              {TOOLS.filter((t) => t.category === c).map((t) => (
                <li><a href={toolUrl(t)}><span class={`mini-icon cat-${c}`}><Icon name={t.icon} /></span>{t.name}</a></li>
              ))}
            </ul>
          </div>
        ))}
        <div class="mega-foot"><span>Everything runs in your browser. Files are never uploaded.</span><a href="/tools/">Browse all {TOOLS.length} tools →</a></div>
      </div>
    </nav>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const megaBtn = document.querySelector<HTMLButtonElement>('[data-mega-btn]');
  const mega = document.querySelector<HTMLElement>('[data-mega]');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('open', open);
  });
  const setMega = (open: boolean, focusBtn = false) => {
    if (!megaBtn || !mega) return;
    megaBtn.setAttribute('aria-expanded', String(open));
    mega.hidden = !open;
    if (!open && focusBtn) megaBtn.focus();
  };
  megaBtn?.addEventListener('click', () => setMega(megaBtn.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('click', (e) => { if (mega && !mega.hidden && !(e.target as Element).closest('[data-mega], [data-mega-btn]')) setMega(false); });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (mega && !mega.hidden) setMega(false, true);
    else if (toggle?.getAttribute('aria-expanded') === 'true') { toggle.click(); toggle.focus(); }
  });
</script>
