---
import Icon from './Icon.astro';
import { SITE, NAV } from '../data/site';
const path = Astro.url.pathname;
const active = (href: string) => path === href || (href !== '/' && path.startsWith(href) && href !== '/tools/') ;
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${SITE.name} home`}>
      <svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#0f2a4d"/><path d="M9 11.5h14M9 16h9M9 20.5h14" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/><circle cx="23" cy="16" r="2.4" fill="#2dd4bf"/></svg>
      <span>{SITE.name}</span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <Icon name="menu" size={22} /><span class="sr-only">Menu</span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Main" data-nav>
      <ul>
        {NAV.map((n) => (
          <li><a href={n.href} aria-current={(n.href === '/tools/' ? path === '/tools/' || path.startsWith('/tools/') : active(n.href)) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('open', open);
  });
</script>
