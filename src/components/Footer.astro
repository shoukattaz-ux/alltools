---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { SITE, hasOptionalTracking } from '../data/site';
import { TOOLS, toolUrl, CATEGORIES } from '../data/tools';
const groups = (['pdf', 'image', 'calculator'] as const).map((c) => ({ title: CATEGORIES[c].name, href: CATEGORIES[c].path, items: TOOLS.filter((t) => t.category === c) }));
const company = [['About us', '/about/'], ['Contact us', '/contact/'], ['FAQ', '/faq/'], ['Guides', '/blog/'], ['Advertise with us', '/advertise/']];
const legal = [['Privacy policy', '/privacy/'], ['Terms and conditions', '/terms/'], ['Disclaimer', '/disclaimer/'], ['Cookie policy', '/cookies/']];
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-about">
        <a href="/" class="brand"><Logo size={32} /><span>{SITE.name}</span></a>
        <p>Free online PDF, image and calculator tools. File tools run in your browser, so your files stay on your device.</p>
        <div class="footer-badges">
          <span><Icon name="lock" size={14} /> Files not uploaded</span>
          <span><Icon name="check" size={14} /> No sign-up</span>
        </div>
      </div>
      {groups.map((g) => (
        <div>
          <h2 class="footer-title"><a href={g.href}>{g.title}</a></h2>
          <ul>{g.items.map((t) => <li><a href={toolUrl(t)}>{t.name}</a></li>)}</ul>
        </div>
      ))}
      <div>
        <h2 class="footer-title">Company</h2>
        <ul>{company.map(([n, h]) => <li><a href={h}>{n}</a></li>)}</ul>
        <h2 class="footer-title">Legal</h2>
        <ul>
          {legal.map(([n, h]) => <li><a href={h}>{n}</a></li>)}
          {hasOptionalTracking() && <li><button type="button" class="link-button" data-consent-open>Cookie settings</button></li>}
        </ul>
      </div>
    </div>
    <div class="footer-note">
      <span>© {new Date().getFullYear()} {SITE.name}. All rights reserved.</span>
      <span>Tools and calculators are for general information. See the <a href="/disclaimer/">disclaimer</a>.</span>
    </div>
  </div>
</footer>
