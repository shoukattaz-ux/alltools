---
import Icon from './Icon.astro';
import { toolUrl, type Tool, CATEGORIES } from '../data/tools';
interface Props { tool: Tool }
const { tool } = Astro.props;
---
<li class="card tool-card" data-category={tool.category} data-search={`${tool.name} ${tool.short} ${tool.search}`.toLowerCase()}>
  <a href={toolUrl(tool)} class="card-link">
    <span class={`tool-icon cat-${tool.category}`}><Icon name={tool.icon} size={24} /></span>
    <span class="card-body">
      <span class="card-title">{tool.name}</span>
      <span class="card-text">{tool.short}</span>
      <span class="card-meta">{CATEGORIES[tool.category].name}{tool.local ? ' · Runs in your browser' : ''}</span>
    </span>
  </a>
</li>
