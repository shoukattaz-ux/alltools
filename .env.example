# Copy to .env for local use. On Cloudflare Pages set these under Settings > Variables and Secrets.
# NONE of these are secrets: PUBLIC_* values are embedded in the public site by design.

# Canonical public origin, no trailing slash. REQUIRED before launch (sitemap, canonical URLs, robots.txt).
SITE_URL=https://www.example.com

# Contact address shown on the Contact / legal pages. REQUIRED before launch.
PUBLIC_CONTACT_EMAIL=

# Optional: Google Analytics 4 measurement ID (G-XXXXXXXXXX). Loaded only after visitor consent.
PUBLIC_GA_ID=

# Optional: advertising. Keep "false" until a publisher account is approved. See docs/ADVERTISING.md.
PUBLIC_ADS_ENABLED=false
PUBLIC_ADSENSE_CLIENT=
