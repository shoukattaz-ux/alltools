{
  "name": "alltools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ToolKit — free browser-based PDF, image and calculator tools. Files are processed locally.",
  "scripts": {
    "dev": "node scripts/copy-pdfjs-assets.mjs && astro dev",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "verify": "node scripts/verify-site.mjs",
    "ci": "npm run lint && npm run check && npm test && npm run build && npm run verify && npm run test:e2e",
    "test:cls": "node tests/e2e/cls.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.4.11",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^9.39.5",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "playwright-core": "^1.65.0",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
