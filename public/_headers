# Cloudflare Pages response headers. See docs/DEPLOYMENT.md.
# NOTE: the Content-Security-Policy below allows ONLY this site's own scripts. If you enable Google Analytics or
# AdSense (docs/ADVERTISING.md), you must extend script-src / connect-src / img-src / frame-src as documented there.
# Cloudflare MERGES matching rules, so do not repeat a header here that a later rule sets (e.g. Cache-Control).

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self' blob: data:; frame-src 'self' https://ads.getalltools.shop; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/pdfjs/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=86400

/favicon.ico
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/og-image.png
  Cache-Control: public, max-age=86400

# Ad frames: each banner runs in a sandboxed iframe on its OWN origin (ads.getalltools.shop, same Worker) that loads one of these pages.
# The different origin is what makes it safe to allow the ad its own storage; it still cannot reach the site.
# They need a looser policy than the rest of the site, so the strict policy is detached here and replaced.
# Only the main site may frame them. Do not add other pages under /ads/.
/ads/*
  ! Content-Security-Policy
  ! X-Frame-Options
  ! Cross-Origin-Opener-Policy
  Content-Security-Policy: default-src https: data: blob:; script-src https: 'unsafe-inline' 'unsafe-eval'; style-src https: 'unsafe-inline'; img-src https: data: blob:; media-src https: blob:; frame-src https:; connect-src https:; base-uri 'none'; form-action https:; frame-ancestors https://getalltools.shop
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=3600

/ads-status.txt
  X-Robots-Tag: noindex
  Cache-Control: no-store
